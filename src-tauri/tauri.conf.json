{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "langlang",
  "version": "0.1.3",
  "identifier": "dev.oudwud.langlang",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "langlang",
        "width": 640,
        "height": 420,
        "minWidth": 420,
        "minHeight": 260,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 Youngjoon Lee",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDN0M2RTkzNEZENERFNzcKUldSMzN0UlBrMjU4SEpxZzlibWVuOE15MXh5WXY2RkIzemtQNGNBZmhCNWhaTjlNU1hkU01ZaDcK",
      "endpoints": [
        "https://github.com/youngjoon-lee/langlang/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
